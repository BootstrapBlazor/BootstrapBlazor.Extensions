<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>11.0.0</Version>
    <OutputType>Exe</OutputType>
    <SatelliteResourceLanguages>false</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup>
    <Title>BootstrapBlazor LLMs docs Generator</Title>
    <Description>Generates LLM-friendly API documentation for BootstrapBlazor components from source code.</Description>
    <PackageId>BootstrapBlazor.LLMsDocsGenerator</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>llms-docs</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.*" />
    <PackageReference Include="System.CommandLine" Version="3.*" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Remove="browser" />
  </ItemGroup>

</Project>

<Project>
  <PropertyGroup>
    <_BootstrapBlazorRtspRid>$(RuntimeIdentifier)</_BootstrapBlazorRtspRid>
    <_BootstrapBlazorRtspRid Condition="'$(_BootstrapBlazorRtspRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</_BootstrapBlazorRtspRid>
    <_BootstrapBlazorRtspExecutable Condition="'$(_BootstrapBlazorRtspRid)' == 'win-x64'">mediamtx.exe</_BootstrapBlazorRtspExecutable>
    <_BootstrapBlazorRtspExecutable Condition="'$(_BootstrapBlazorRtspRid)' == 'linux-x64' Or '$(_BootstrapBlazorRtspRid)' == 'linux-arm64' Or '$(_BootstrapBlazorRtspRid)' == 'linux-arm' Or '$(_BootstrapBlazorRtspRid)' == 'osx-x64' Or '$(_BootstrapBlazorRtspRid)' == 'osx-arm64'">mediamtx</_BootstrapBlazorRtspExecutable>
    <_BootstrapBlazorRtspRelativePath Condition="'$(_BootstrapBlazorRtspExecutable)' != ''">tools\$(_BootstrapBlazorRtspRid)\$(_BootstrapBlazorRtspExecutable)</_BootstrapBlazorRtspRelativePath>
    <_BootstrapBlazorRtspSource Condition="'$(_BootstrapBlazorRtspRelativePath)' != ''">$(MSBuildThisFileDirectory)..\$(_BootstrapBlazorRtspRelativePath)</_BootstrapBlazorRtspSource>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(_BootstrapBlazorRtspSource)')">
    <None Include="$(_BootstrapBlazorRtspSource)"
          Link="$(_BootstrapBlazorRtspRelativePath)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <ContentWithTargetPath Include="$(MSBuildThisFileDirectory)..\README.Rtsp.md"
                           TargetPath="tools\README.Rtsp.md"
                           CopyToOutputDirectory="PreserveNewest"
                           CopyToPublishDirectory="PreserveNewest"
                           ExcludeFromSingleFile="true" />
  </ItemGroup>

  <Target Name="BootstrapBlazorRtspReportBuildOutput" AfterTargets="Build"
          Condition="Exists('$(_BootstrapBlazorRtspSource)') And '$(TargetDir)' != '' And Exists('$(TargetDir)$(_BootstrapBlazorRtspRelativePath)')">
    <PropertyGroup>
      <_BootstrapBlazorRtspOutput>$([MSBuild]::NormalizePath('$(TargetDir)', '$(_BootstrapBlazorRtspRelativePath)'))</_BootstrapBlazorRtspOutput>
    </PropertyGroup>
    <Exec Condition="'$(OS)' != 'Windows_NT' And '$(_BootstrapBlazorRtspExecutable)' == 'mediamtx'"
          EnvironmentVariables="BOOTSTRAPBLAZOR_RTSP_EXECUTABLE=$(_BootstrapBlazorRtspOutput)"
          Command="chmod a+x &quot;$BOOTSTRAPBLAZOR_RTSP_EXECUTABLE&quot;" />
    <Message Text="[Rtsp] MediaMTX available at $(_BootstrapBlazorRtspOutput)" Importance="high" />
  </Target>

  <Target Name="BootstrapBlazorRtspReportPublishOutput" AfterTargets="Publish"
          Condition="Exists('$(_BootstrapBlazorRtspSource)') And '$(PublishDir)' != '' And Exists('$(PublishDir)$(_BootstrapBlazorRtspRelativePath)')">
    <PropertyGroup>
      <_BootstrapBlazorRtspOutput>$([MSBuild]::NormalizePath('$(PublishDir)', '$(_BootstrapBlazorRtspRelativePath)'))</_BootstrapBlazorRtspOutput>
    </PropertyGroup>
    <Exec Condition="'$(OS)' != 'Windows_NT' And '$(_BootstrapBlazorRtspExecutable)' == 'mediamtx'"
          EnvironmentVariables="BOOTSTRAPBLAZOR_RTSP_EXECUTABLE=$(_BootstrapBlazorRtspOutput)"
          Command="chmod a+x &quot;$BOOTSTRAPBLAZOR_RTSP_EXECUTABLE&quot;" />
    <Message Text="[Rtsp] MediaMTX available at $(_BootstrapBlazorRtspOutput)" Importance="high" />
  </Target>
</Project>

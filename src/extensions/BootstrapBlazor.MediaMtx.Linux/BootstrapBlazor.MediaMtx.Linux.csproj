<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>11.0.0-beta01</Version>
  </PropertyGroup>

  <PropertyGroup>
    <Description>MediaMTX 1.21.4 executables for Linux x64, arm64 and armv7.</Description>
    <PackageLicenseExpression>Apache-2.0 AND MIT</PackageLicenseExpression>
    <PackageTags>BootstrapBlazor MediaMTX Linux</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Remove="browser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BootstrapBlazor.MediaMtx\BootstrapBlazor.MediaMtx.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="tools\**\*;LICENSE.MediaMTX;BootstrapBlazor.MediaMtx.Linux.targets" />
    <None Include="tools\**\*" Pack="true" PackagePath="tools\" TargetPath="mediamtx-tools\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="LICENSE.MediaMTX" Pack="true" PackagePath="" TargetPath="mediamtx-tools\linux\LICENSE.MediaMTX" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive\BootstrapBlazor.MediaMtx.Linux.targets" Pack="true" PackagePath="buildTransitive\BootstrapBlazor.MediaMtx.Linux.targets" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <Version>11.0.2</Version>
    <SkillName>bb-ip2region</SkillName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageTags>Bootstrap Blazor WebAssembly wasm UI Components Ip Region</PackageTags>
    <Description>Bootstrap UI components extensions of IP2Region.NET</Description>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="buildTransitive\*.targets" PackagePath="buildTransitive\" />
    <Content Include="contentFiles\ip2region_v4.xdb" PackagePath="contentFiles\ip2region_v4.xdb" />
    <Content Include="contentFiles\ip2region_v6.xdb" PackagePath="contentFiles\ip2region_v6.xdb" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BootstrapBlazor" Version="$(BBVersion)" />
    <PackageReference Include="IP2Region.Net" Version="3.0.1" />
  </ItemGroup>

</Project>
